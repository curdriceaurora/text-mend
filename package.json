{
  "name": "text-mend",
  "version": "1.0.0",
  "description": "Text Mend — repair reversed, mojibake, and garbled article text locally in a clean reader view (Chrome MV3).",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "build:icons": "node tools/gen-icons.mjs",
    "build:corpus": "node tools/build-corpus.mjs",
    "package": "node tools/build-package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0"
  }
}
